 extern MACHINE_DRIVER_EXTERN(s6);
 extern MACHINE_DRIVER_EXTERN(s6S);
+extern void (*s6_rpuHook)(double seconds);   /* rpu.c: runs an RPU board's Mega for that long */
 #define s6_mS6      s6
